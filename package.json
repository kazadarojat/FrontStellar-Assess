{
  "name": "frontstellar-assess",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Benchmark multi-provider untuk model AI OpenAI-compatible: metrik, grafik, statistik, dan riwayat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "mock": "node scripts/mock-provider.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.1.0",
    "gpt-tokenizer": "^3.0.1",
    "lucide-react": "^1.66.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3"
  }
}
